# ==============================================================================
# COGENT — Environment Configuration Template (.env.example)
# Adheres to docs/ENGINEERING.md Section 4 & docs/SECURITY.md
# ==============================================================================

# Next.js & App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="debug"

# Clerk Authentication (Multi-Tenant JWT with org_id claims)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Supabase Database & Storage (PostgreSQL 16 + pgvector)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Service role key is STRICTLY QUARANTINED to CI, migrations, and seed scripts.
# NEVER expose to client bundles or public API route handlers.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# AI Engine (Google Gemini Multi-Model Routing & Embeddings)
GEMINI_API_KEY="AIzaSy..."
AI_FAST_MODEL="gemini-3.8-flash"
AI_REASONING_MODEL="gemini-3.5-pro"
AI_EMBEDDING_MODEL="gemini-embedding-2"

# Background Asynchronous Jobs (Inngest) & Notifications (Resend)
INNGEST_EVENT_KEY="test"
INNGEST_SIGNING_KEY="test"
RESEND_API_KEY="re_..."
